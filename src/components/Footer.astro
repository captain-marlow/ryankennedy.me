---
import { site } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="wrap">
  <span class="mono">© {year} {site.author}</span>
  <ul>
    <li><a href={site.links.github}>GitHub</a></li>
    <li><a href={site.links.linkedin}>LinkedIn</a></li>
    <li><a href="/contact">Contact</a></li>
    <li><a href="/rss.xml">RSS</a></li>
  </ul>
</footer>
<style>
  footer { margin: 5rem auto 3rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  ul { list-style: none; display: flex; gap: 1.25rem; margin: 0; padding: 0; }
  a { font-family: var(--font-mono); font-size: var(--fs-sm); color: var(--text-muted); }
  a:hover { color: var(--text); }
</style>
