---
import ThemeToggle from './ThemeToggle.astro';
const path = Astro.url.pathname;
const items = [
  { href: '/notes', label: 'Notes' },
  { href: '/articles', label: 'Articles' },
  { href: '/contact', label: 'Contact' },
];
const current = (href: string) => path === href || path.startsWith(href + '/');
---
<nav class="nav wrap" aria-label="Primary">
  <a class="brand" href="/" aria-label="Home"><span class="tilde">~</span>/ryan</a>
  <ul>
    {items.map((i) => (
      <li><a href={i.href} aria-current={current(i.href) ? 'page' : undefined}>{i.label}</a></li>
    ))}
    <li><ThemeToggle /></li>
  </ul>
</nav>
<style>
  .nav { display: flex; align-items: center; justify-content: space-between; padding-top: 1.75rem; padding-bottom: 3.5rem; }
  .brand { font-family: var(--font-mono); font-size: var(--fs-sm); font-weight: 500; color: var(--text); }
  .brand .tilde { color: var(--accent); }
  ul { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0; align-items: center; }
  li a { font-size: var(--fs-sm); color: var(--text-muted); }
  li a[aria-current='page'], li a:hover { color: var(--text); }
</style>
