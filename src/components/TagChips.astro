---
import type { CollectionEntry } from 'astro:content';
const { articles, current } = Astro.props as { articles: CollectionEntry<'articles'>[]; current?: string };
const tags = [...new Set(articles.flatMap((a) => a.data.tags))].sort();
---
<nav class="chips" aria-label="Filter by tag">
  <a class="chip" href="/articles" aria-current={current ? undefined : 'page'}>All</a>
  {tags.map((t) => <a class="chip" href={`/articles/tag/${t}`} aria-current={current === t ? 'page' : undefined}>{t}</a>)}
</nav>
