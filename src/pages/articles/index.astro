---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import TagChips from '../../components/TagChips.astro';
const articles = (await getCollection('articles', (e) => !e.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Articles">
  <section>
    <h1>Articles</h1>
    <p class="mono lede">Tutorials and incident write-ups from a self-hosted homelab.</p>
    <TagChips articles={articles} />
    <ul class="list">{articles.map((a) => <ArticleRow entry={a} showTags />)}</ul>
  </section>
</Base>
