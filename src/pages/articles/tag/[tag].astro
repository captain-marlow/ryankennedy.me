---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import TagChips from '../../../components/TagChips.astro';

export async function getStaticPaths() {
  const all = (await getCollection('articles', (e) => !e.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const tags = [...new Set(all.flatMap((a) => a.data.tags))].sort();
  return tags.map((tag) => ({ params: { tag }, props: { all, articles: all.filter((a) => a.data.tags.includes(tag)), tag } }));
}
const { all, articles, tag } = Astro.props;
---
<Base title={`Articles tagged ${tag}`}>
  <section>
    <h1>Articles</h1>
    <p class="mono lede">Tagged <strong>{tag}</strong>.</p>
    <TagChips articles={all} current={tag} />
    <ul class="list">{articles.map((a) => <ArticleRow entry={a} showTags />)}</ul>
  </section>
</Base>
